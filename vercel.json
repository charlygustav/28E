{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "experimentalServices": {
    "signaling-server": {
      "root": "signaling-server",
      "entrypoint": "server.js",
      "routePrefix": "/"
    }
  }
}
