{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(tv|dclf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dclf.yaire.site"
        }
      ],
      "destination": "/dclf.html"
    },
    {
      "source": "/dclf",
      "has": [
        {
          "type": "host",
          "value": "dclf.yaire.site"
        }
      ],
      "destination": "/dclf.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tv.yaire.site"
        }
      ],
      "destination": "/tv.html"
    },
    {
      "source": "/tv",
      "has": [
        {
          "type": "host",
          "value": "tv.yaire.site"
        }
      ],
      "destination": "/tv.html"
    },
    {
      "source": "/vc-api/:path*",
      "destination": "https://voice.yaire.site/:path*"
    },
    {
      "source": "/yt-search/piped/:path*",
      "destination": "https://pipedapi.kavin.rocks/:path*"
    },
    {
      "source": "/yt-search/inv/:path*",
      "destination": "https://inv.nadeko.net/api/v1/:path*"
    },
    {
      "source": "/__/:path*",
      "destination": "https://yaire-591ca.firebaseapp.com/__/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/dclf",
      "has": [
        {
          "type": "host",
          "value": "yaire.site"
        }
      ],
      "destination": "https://dclf.yaire.site/",
      "permanent": false
    },
    {
      "source": "/dclf",
      "has": [
        {
          "type": "host",
          "value": "www.yaire.site"
        }
      ],
      "destination": "https://dclf.yaire.site/",
      "permanent": false
    },
    {
      "source": "/dclf.html",
      "has": [
        {
          "type": "host",
          "value": "yaire.site"
        }
      ],
      "destination": "https://dclf.yaire.site/",
      "permanent": false
    },
    {
      "source": "/dclf.html",
      "has": [
        {
          "type": "host",
          "value": "www.yaire.site"
        }
      ],
      "destination": "https://dclf.yaire.site/",
      "permanent": false
    },
    {
      "source": "/tv",
      "has": [
        {
          "type": "host",
          "value": "yaire.site"
        }
      ],
      "destination": "https://tv.yaire.site/",
      "permanent": false
    },
    {
      "source": "/tv",
      "has": [
        {
          "type": "host",
          "value": "www.yaire.site"
        }
      ],
      "destination": "https://tv.yaire.site/",
      "permanent": false
    },
    {
      "source": "/tv.html",
      "has": [
        {
          "type": "host",
          "value": "yaire.site"
        }
      ],
      "destination": "https://tv.yaire.site/",
      "permanent": false
    },
    {
      "source": "/tv.html",
      "has": [
        {
          "type": "host",
          "value": "www.yaire.site"
        }
      ],
      "destination": "https://tv.yaire.site/",
      "permanent": false
    }
  ]
}
