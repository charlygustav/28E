{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vc-api/:path*",
      "destination": "https://two8e-signaling.onrender.com/:path*"
    },
    {
      "source": "/__/:path*",
      "destination": "https://yaire-591ca.firebaseapp.com/__/:path*"
    }
  ]
}
